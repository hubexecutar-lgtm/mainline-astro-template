{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mainline-astro-template",
  "compatibility_date": "2026-10-06",
  // Site 100% estático (output: "static"): o Worker só serve os arquivos de ./dist
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
